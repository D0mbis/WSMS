<Window x:Class="WSMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WSMS"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:WSMS.ViewModels"
        xmlns:models="clr-namespace:WSMS.Models"
        mc:Ignorable="d"
        Title="{Binding Title}" MinHeight="800" MinWidth="700" MaxWidth="700">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Modifiers="Shift" Key="Esc" Command="{Binding CloseApplicationCommand}"/>
        <!-- Fix it!!!! -->
    </Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding CloseApplicationCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel >
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Exit" Command="{Binding CloseApplicationCommand}"/>
            </MenuItem>
            <MenuItem Header="Settings">
            </MenuItem>
        </Menu>
        <TabControl Margin="5">
            <TabItem Width="100" Header="Home">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="91*"/>
                        <RowDefinition Height="381*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="317*"/>
                        <ColumnDefinition Width="118*"/>
                        <ColumnDefinition Width="199*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="30" 
                        HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Content="{Binding DriverBtnContent, UpdateSourceTrigger=PropertyChanged}"
                        Command="{Binding StartBrowserCommand}" Width="93"/>
                    <Button Grid.Column="0" Height="30" Width="93"
                            Content="Contacts" Command="{Binding OpenContactsCommand}"/>
                    <Button Grid.Column="1" Height="30" 
                         HorizontalAlignment="Left" VerticalAlignment="Top" 
                         Content="Start Sending"
                         Command="{Binding StartSendingCommand}" Width="93"/>
                    <Button Grid.Row="1" Grid.Column="1" Height="30" 
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0"
                         Content="Check delivery" Width="100"
                         Command="{Binding CheckDeliveryCommand}"/>
                    <TextBox x:Name="IdentifierText"
                        Grid.Column="2" Grid.Row="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" 
                        Height="30" Width="180" AutomationProperties.HelpText="Message identifier text"
                        TextAlignment="Left"  VerticalContentAlignment="Center" 
                        Text="{Binding IdentifierText}"/>
                    <Label Grid.Column="2" Grid.Row="1" Margin="30,35,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="11">
                        Message identifier text</Label>
                </Grid>
            </TabItem>
            <TabItem Width="Auto" Header="Create sanding">
                <Grid Margin="10">
                    <!-- Title -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="WMS" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <!-- Control Buttons and Progress -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Start" Width="80" Height="40" Margin="5"/>
                        <Button Content="Stop" Width="80" Height="40" Margin="5" IsEnabled="False"/>
                        <Button Content="Pause/Continue" Width="120" Height="40" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <ProgressBar Width="300" Height="20" Value="26" Maximum="75" Background="LightGray" Foreground="LightGreen"/>
                        <TextBlock Text="Progress: 26/75" Margin="10,0,0,0"/>
                        <TextBlock Text="Time left: 10:13" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Customer and Task Information -->
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Now: " Foreground="Green"/>
                            <TextBlock Text="Customer 1"/>
                            <TextBlock Text="Next: " Foreground="Green" Margin="10,0,0,0"/>
                            <TextBlock Text="Customer 2"/>
                        </StackPanel>

                        <!-- Task 1 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2713; " Foreground="Red"/>
                                    <TextBlock Text="Предложение недели"/>
                                    <TextBlock Text="Турфирмы наколенник со светом EY Medical"/>
                                    <TextBlock Text="&#x2014;"/>
                                    <TextBlock Text="&#x2014;"/>
                                    <TextBlock Text="&#x2014;"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="другие свет"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="керамический подшипник"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="4-х канальный тип подклюнения"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="заласние ротора в наличии"/>
                                </StackPanel>
                                <TextBlock Text="&#x2014; цена актуальна до 15.03.2025."/>
                                <TextBlock Text="&#x2014; (77/993)378-17-61"/>
                                <TextBlock Text="Брокер: &#x2713;"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="НОВОЯХТИНСК"/>
                                    <TextBlock Text="27-28"/>
                                    <CheckBox IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Task 2 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2713; " Foreground="Red"/>
                                    <TextBlock Text="Предложение недели"/>
                                    <TextBlock Text="Турфирмы наколенник со светом EY Medical"/>
                                    <TextBlock Text="&#x2014;"/>
                                    <TextBlock Text="&#x2014;"/>
                                    <TextBlock Text="&#x2014;"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="другие свет"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="керамический подшипник"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="4-х канальный тип подклюнения"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2022; " Foreground="Green"/>
                                    <TextBlock Text="заласние ротора в наличии"/>
                                </StackPanel>
                                <TextBlock Text="&#x2014; цена актуальна до 15.03.2025."/>
                                <TextBlock Text="&#x2014; (77/993)378-17-61"/>
                                <TextBlock Text="Брокер: &#x2713;"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="НОВОЯХТИНСК"/>
                                    <TextBlock Text="27-28"/>
                                    <CheckBox IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </TabItem>
            <TabItem Width="Auto" Header="GPT">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Верхний заголовок -->
                    <TextBlock Text="WSMS" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,10,0,0" Width="84" Grid.Column="1"/>

                    <!-- Кнопки управления -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,40,0,0" Grid.Column="1">
                        <Button Content="Start" Width="80" Height="40" Margin="10"/>
                        <Button Content="Stop" Width="80" Height="40" Margin="10"/>
                        <Button Content="Pause/Continue" Width="120" Height="40" Margin="10"/>
                    </StackPanel>

                    <!-- Прогресс и таймер -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="127,100,0,0" Grid.ColumnSpan="2">
                        <TextBlock Text="Now: Customer 1  " FontSize="14"/>
                        <TextBlock Text="Next: Customer 2  " FontSize="14"/>
                        <TextBlock Text="Progress: " FontSize="14"/>
                        <TextBlock Text="26" Foreground="Green" FontSize="14"/>
                        <TextBlock Text="/75  " FontSize="14"/>
                        <TextBlock Text="Time left: " FontSize="14"/>
                        <TextBlock Text="10:13" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>

                    <!-- Прогресс-бар -->
                    <ProgressBar Width="600" Height="20" Value="35" Maximum="100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="42,130,0,0" Grid.ColumnSpan="2"/>

                    <!-- Список заказов -->
                    <StackPanel Orientation="Vertical" Margin="20,170,20,20" Grid.ColumnSpan="2">
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5" Background="LightGray" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- Пустое изображение -->
                                <Rectangle Width="80" Height="80" Fill="LightGray" Stroke="Black" Grid.Column="0"/>

                                <!-- Описание -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="📌Предложение недели" FontWeight="Bold"/>
                                    <TextBlock Text="Турбинный наконечник со светом EYY Medical 🇨🇳" FontSize="12"/>
                                    <TextBlock Text="🔥 4300р. ~4900р." Foreground="Red" FontSize="12"/>
                                    <TextBlock Text="🟢 яркий свет" FontSize="12"/>
                                    <TextBlock Text="🟢 керамический подшипник" FontSize="12"/>
                                    <TextBlock Text="🟢 низкий уровень шума" FontSize="12"/>
                                    <TextBlock Text="🟢 4-х канальный тип подключения" FontSize="12"/>
                                    <TextBlock Text="🟢 запасные роторы в наличии" FontSize="12"/>
                                    <TextBlock Text="⌛ цена актуальна до 15.03.2025" FontSize="12"/>
                                    <TextBlock Text="📞 +7(995)378-17-61" FontSize="12"/>
                                    <TextBlock Text="📍БорПакет" FontSize="12"/>
                                </StackPanel>

                                <!-- Метка города и галочка -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Новошахтинск" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="27-28" FontSize="14"/>
                                    <Rectangle Width="50" Height="50" Stroke="Black" Margin="10">
                                        <Rectangle.Fill>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="✔" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ListView Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" HorizontalContentAlignment="Center" Margin="2"
                                  BorderThickness="1" ItemContainerStyle="{StaticResource CustomListViewItemStyle}"
                                  ItemsSource="{Binding MessagesView, UpdateSourceTrigger=PropertyChanged}" 
                                  SelectedItem="{Binding SelectedMessage, UpdateSourceTrigger=PropertyChanged}">      
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="0" HorizontalAlignment="Center" >
                                        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0.1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0.1">
                                                    <Image Source="{ Binding Message.Image}" Height="200" Width="Auto" 
                                 HorizontalAlignment="Stretch" Margin="3"/>
                                                </Border>
                                                <TextBlock Text="{Binding Message.Name}" TextWrapping="Wrap" Margin="10,0,0,0" 
                                 Grid.Column="1" Width="120" MaxHeight="120" VerticalAlignment="Center"
                                 FontSize="18"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </StackPanel>
                </Grid>


            </TabItem>

            <TabItem Width="Auto" Header="M">

                <Grid>
                    <!-- Top Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Start" Width="100" Margin="5"/>
                        <Button Content="Stop" Width="100" Margin="5"/>
                        <Button Content="Pause/Continue" Width="120" Margin="5"/>
                    </StackPanel>

                    <!-- Progress Bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Fill="Green" Width="300" Height="20"/>
                            <Rectangle Fill="Gray" Width="500" Height="20"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Text -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Now: Customer 1" Margin="5"/>
                        <TextBlock Text="Next: Customer 2" Margin="5"/>
                        <TextBlock Text="Progress: 26/75" Margin="5"/>
                        <TextBlock Text="Time left: 10:13" Margin="5"/>
                    </StackPanel>

                    <!-- Main Content -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <!-- First Section -->
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Приложенные недоделки" Foreground="Red"/>
                                    <TextBlock Text="Турбинный наконечник со светой EYY Medical"/>
                                    <TextBlock Text="43000р. * 4000р."/>
                                    <TextBlock Text="Всего: 47000р."/>
                                    <TextBlock Text="Звонил сегодня, все ок"/>
                                    <TextBlock Text="4-х канальный тип подключения"/>
                                    <TextBlock Text="Запасные роторы в наличии"/>
                                    <TextBlock Text="Цена актуальна до 15.03.2025"/>
                                    <TextBlock Text="Тел: +7(999)378-17-61"/>
                                    <TextBlock Text="Возражений нет"/>
                                </StackPanel>
                                <CheckBox Content="Новошахтинск 27-28" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Second Section -->
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Приложенные недоделки" Foreground="Red"/>
                                    <TextBlock Text="Турбинный наконечник со светой EYY Medical"/>
                                    <TextBlock Text="43000р. * 4000р."/>
                                    <TextBlock Text="Всего: 47000р."/>
                                    <TextBlock Text="Звонил сегодня, все ок"/>
                                    <TextBlock Text="4-х канальный тип подключения"/>
                                    <TextBlock Text="Запасные роторы в наличии"/>
                                    <TextBlock Text="Цена актуальна до 15.03.2025"/>
                                    <TextBlock Text="Тел: +7(999)378-17-61"/>
                                    <TextBlock Text="Возражений нет"/>
                                </StackPanel>
                                <CheckBox Content="Новошахтинск 27-28" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>



            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
