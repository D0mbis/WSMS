<Window x:Class="WSMS.Views.Windows.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WSMS.Views.Windows"
        mc:Ignorable="d"
        Title="MessagesWindow" Height="850" Width="1300"  SizeToContent="Width">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition MinWidth="500"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid HorizontalAlignment="Stretch" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image x:Name="ImageBlock" VerticalAlignment="Stretch" Height="550" Stretch="Uniform" Margin="3"  
                  Grid.Column="0" Grid.Row="0"
                  Source="{Binding SelectedMessage.Message.Image, UpdateSourceTrigger=PropertyChanged}"
                  Style="{StaticResource ImageDefaultStyle}" AllowDrop="True" Drop="Image_Drop"/>
            <TextBox Grid.Column="0" Grid.Row="1"
                    TextWrapping="Wrap" AcceptsTab="True" AcceptsReturn="True"
                    Text="{Binding SelectedMessage.Message.Text, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
        </Grid>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2" Content="Save" Command="{Binding OpenSaveMessageWindowCommand}"/>
            <Button Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2" Content="Delete" Command="{Binding DeleteMessageCommand}"/>
        </Grid>
        <ListView Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" HorizontalContentAlignment="Left" Margin="2"
                  BorderThickness="1" ItemContainerStyle="{StaticResource CustomListViewItemStyle}"
                  ItemsSource="{Binding MessagesView, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedMessage, UpdateSourceTrigger=PropertyChanged}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="0" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{ Binding Message.Image}" Height="200" Width="160" HorizontalAlignment="Center" Margin="3"/>
                            <TextBlock Text="{Binding Message.Name}" TextWrapping="Wrap" Margin="10,0,0,0" Grid.Column="1" Width="120" MaxHeight="120" VerticalAlignment="Center"
                                    FontSize="18"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>
