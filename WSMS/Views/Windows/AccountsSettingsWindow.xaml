<Window x:Class="WSMS.Views.AccountsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WSMS.Views"
        xmlns:vm="clr-namespace:WSMS.ViewModels"
        mc:Ignorable="d"
    Title="WhatsApp Manager" Height="350" Width="525">

    <Window.DataContext>
        <vm:WhatsAppAccountsSettingsViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseWindowCommand}"/>
    </Window.InputBindings>
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="WhatsApp Account Manager"
                               FontSize="20" FontWeight="Bold"
                               Margin="10" HorizontalAlignment="Center"/>

            <!-- Accounts List -->
            <DataGrid x:Name="AccountDataGrid"
          Grid.Row="1" Grid.Column="0"
          Margin="10"
          ItemsSource="{Binding Accounts}"
          SelectedItem="{Binding SelectedAccount}"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          CanUserAddRows="False"
          CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="Auto" />
                    <DataGridTextColumn Header="ID" Binding="{Binding AvailableForSending}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>


            <!-- Control Panel -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10" VerticalAlignment="Top">
                <Button x:Name="StartSessionButton" Content="Start session" Margin="5" Width="100" Command="{Binding StartSessionCommand}"/>
                <Button x:Name="StopSessionButton" Content="Stop session" Margin="5" Width="100" Command="{Binding StopSessionCommand}"/>
                <Button x:Name="RemoveAccountButton" Content="Remove account" Margin="5" Width="100" Command="{Binding DeleteAccountCommand}"/>
                <Button x:Name="AddNewAccountButton" Content="Add new account" Margin="5" Width="100" Command="{Binding AddNewAccountCommand}"/>
                <Grid>
                    <!-- Input TextBox -->
                    <TextBox x:Name="InputBox" 
                         Width="200" 
                         Height="30" 
                         VerticalAlignment="Top" 
                         HorizontalAlignment="Left" 
                         Margin="10" 
                         Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Placeholder Text -->
                    <TextBlock Text="Введите текст..." 
                           Foreground="Gray" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="15,0,0,0"
                           IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!-- Скрыть подсказку, если в TextBox есть текст -->
                                    <DataTrigger Binding="{Binding ElementName=InputBox, Path=Text.Length}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusTextBlock}" Margin="10,0"/>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
