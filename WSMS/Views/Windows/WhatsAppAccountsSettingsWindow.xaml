<Window x:Class="WSMS.Views.AccountsSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WSMS.Views"
        xmlns:vm="clr-namespace:WSMS.ViewModels"
        mc:Ignorable="d"
    Title="WhatsApp Manager" Height="350" Width="525">
    
    <Window.DataContext>
        <vm:WhatsAppAccountsSettingsViewModel/>
    </Window.DataContext>
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="WhatsApp Account Manager"
                               FontSize="20" FontWeight="Bold"
                               Margin="10" HorizontalAlignment="Center"/>

            <!-- Accounts List -->
            <ListBox x:Name="AccountListBox" Grid.Row="1" Grid.Column="0" Margin="10"
                             DisplayMemberPath="AccountName"
                             SelectedValuePath="AccountId"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     ItemsSource="{Binding Accounts}"
                     SelectedItem="{Binding SelectedAccount}"/>

            <!-- Control Panel -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10" VerticalAlignment="Top">
                <Button x:Name="StartSessionButton" Content="Start Session" Margin="5" Width="100" Command="{Binding StartSessionCommand}"/>
                <Button x:Name="StopSessionButton" Content="Stop Session" Margin="5" Width="100" Command="{Binding StopSessionCommand}"/>
                <Button x:Name="AddAccountButton" Content="Add Account" Margin="5" Width="100" Command="{Binding AddNewAccountCommand}"/>
                <Button x:Name="RemoveAccountButton" Content="Remove Account" Margin="5" Width="100" Command="{Binding DeleteAccountCommand}"/>
            </StackPanel>

            <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusTextBlock}" Margin="10,0"/>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
